# ==============================================================================
# MYSHELTER — Environment Variables Example
# Copy these variables into Vercel Project Settings -> Environment Variables
# (or create a local .env file for development)
# ==============================================================================

# 1. MongoDB Atlas Connection URI
# Found in: MongoDB Atlas Dashboard -> Database -> Connect -> Drivers -> Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# 2. MongoDB Database Name (Default: myshelter)
MONGODB_DB_NAME=MYSHELTER

# 3. Admin Portal Password
# Used to authenticate at the /admin portal to inspect users, bookings, and preferences
ADMIN_PASSWORD=admin2026

# 4. JWT Secret Key
# Any long, random secret string used to sign user and admin authentication tokens
JWT_SECRET=c43dfdd2afc4833d9bda21d7de58132c0dbbdfbeddf697125335c05df8d7ece29e90c37e8ea4d92045da807f20077819a37a9cb464d3325ab8820b2d8eab5c96

# 5. OTP Time-to-Live in Minutes (Optional, default: 10)
# Configures the expiration window for email verification OTP codes
OTP_TTL_MINUTES=10

# 6. Require Email Verification (Optional, default: false)
# Option A (false, DEFAULT): Email verification is non-blocking. Users can sign in and browse immediately.
# Option B (true): Email verification is enforced. Unverified users receive 403 and must verify OTP to sign in.
REQUIRE_EMAIL_VERIFICATION=true

# ==============================================================================
# Gmail / SMTP Email Delivery Configuration
# To send actual OTP verification emails to users' Gmail accounts:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
#    (Select App: Mail, Device: Other -> "MYSHELTER")
# 3. Paste your Gmail address and 16-character app password below:
# ==============================================================================
GMAIL_USER=srishticodes3826@gmail.com
GMAIL_APP_PASSWORD=hulb uisn nypd elxm

# Optional custom sender name/email (default: "MYSHELTER" <your-email@gmail.com>)
# EMAIL_FROM="MYSHELTER" <your-email@gmail.com>

# Alternative generic SMTP settings (if not using Gmail):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-api-key
